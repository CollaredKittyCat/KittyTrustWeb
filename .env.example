# --- Database ---------------------------------------------------------------
# Railway: the PostgreSQL plugin fills this in for you automatically.
# Local:   point it at your local Postgres (see README).
DATABASE_URL=postgres://postgres@localhost:5432/freelancer_reviews

# --- Server -----------------------------------------------------------------
# Railway assigns PORT automatically; only set it locally.
PORT=3000

# --- Staff dashboard --------------------------------------------------------
# Password used to sign in at /dashboard
STAFF_PASSWORD=change-me
# Long random string used to sign login cookies (openssl rand -hex 32)
SESSION_SECRET=

# --- Site -------------------------------------------------------------------
SITE_NAME=Freelance Reviews
